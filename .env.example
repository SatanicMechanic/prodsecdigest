# prodsecdigest — local runs only. Copy to .env and fill in.
# CI reads these from repo secrets/variables instead, never from .env.
# Full table: README §2.

# ---- LLM: model (required) -------------------------------------------------
# REQUIRED, and deliberately left blank — the code carries no default, so a new
# model release is a config change rather than a code change. Pick one:
#   github: openai/gpt-4.1-nano   xai: grok-4.5   mistral: mistral-large-latest
LLM_MODEL=

# ---- LLM: provider (optional, defaults to GitHub Models) -------------------
# The default needs no third-party account or billing — just the PAT below.
# One of: github xai mistral openai groq openrouter together deepseek ollama
#LLM_PROVIDER=github

# Key for the chosen provider — only ONE of these is ever needed.
# github -> GH_MODELS_TOKEN: fine-grained PAT with models:read.
#           Actions' built-in GITHUB_TOKEN does NOT have that scope.
GH_MODELS_TOKEN=github_pat_xxx
#XAI_API_KEY=xai-xxx
#MISTRAL_API_KEY=
#OPENAI_API_KEY=sk-xxx
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#TOGETHER_API_KEY=
#DEEPSEEK_API_KEY=
#OLLAMA_API_KEY=

# Provider not in the list above? Set these two instead of LLM_PROVIDER.
#LLM_BASE_URL=
#LLM_API_KEY_ENV=

# JSON merged into the request body. Defaults per provider:
#   {} for github, {"reasoning_effort": "low"} for xai.
#LLM_EXTRA=

# ---- Email delivery (optional) ---------------------------------------------
RESEND_API_KEY=re_xxx
# Comma-separated recipient list.
DIGEST_TO_EMAIL=you@example.com,other@example.com
# Must be a domain you have verified in Resend.
DIGEST_FROM_EMAIL=digest@your-verified-domain.com

# ---- Web search (strongly recommended) -------------------------------------
# Without this the web-search pass is a no-op.
# Free tier: 2,000 queries/month — well above what this uses.
BRAVE_API_KEY=BSA_xxx

# Optional: URL of a hosted Brave goggle to bias search ranking toward curated
# security sources. Brave fetches this URL at query time, so it must be
# PUBLICLY reachable — a private fork's own raw URL will NOT work. Default to
# the public upstream copy below. To customize, host your edited goggle at any
# public URL (a public gist works) — and since it must be public, keep the
# rules generic: don't encode stack hints (e.g. boosting only your vendors).
# Unset = no goggle applied.
#BRAVE_GOGGLES=https://raw.githubusercontent.com/SatanicMechanic/prodsecdigest/main/security-news.goggle

# ---- Slack (optional) ------------------------------------------------------
# When set, the plain-text digest is also posted to that channel.
# Unset = Slack step is a no-op.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
